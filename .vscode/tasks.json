{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "rust-build",
            "type": "shell",
            "command": "make",
            "args": [
                "build",
                "PROFILE=debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$rustc"
        }
    ]
}
